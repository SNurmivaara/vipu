#!/usr/bin/env bash
# Pre-commit hook for vipu project
# Mirrors ./test.sh for the components with staged changes, minus the slow
# frontend production build. Commits touching only docs, workflows, etc. skip
# the component checks.

set -uo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Git runs hooks from the repository root; make that explicit.
cd "$(git rev-parse --show-toplevel)"

echo -e "${YELLOW}Running pre-commit checks...${NC}"

STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)

has_staged() {
    echo "$STAGED" | grep -q "^$1/"
}

RUN_BACKEND=0
RUN_MCP=0
RUN_FRONTEND=0
# MCP tests run against the real Flask app, so backend changes affect them too.
if has_staged backend; then RUN_BACKEND=1; RUN_MCP=1; fi
if has_staged mcp-server; then RUN_MCP=1; fi
if has_staged frontend; then RUN_FRONTEND=1; fi

FAILED=0

# run_check <label> <fix hint> <command...>  (runs in the current directory)
run_check() {
    local label="$1" hint="$2"
    shift 2
    echo "Running $label..."
    if "$@"; then
        echo -e "${GREEN}✓ $label passed${NC}"
    else
        echo -e "${RED}✗ $label failed${NC}"
        echo "  Fix: $hint"
        FAILED=1
    fi
}

run_python_checks() {
    local name="$1"
    (
        cd "$2" || exit 1
        run_check "$name: black" "cd $2 && uv run --locked black ." uv run --locked black --check .
        run_check "$name: ruff" "cd $2 && uv run --locked ruff check . --fix" uv run --locked ruff check .
        run_check "$name: mypy" "cd $2 && uv run --locked mypy ." uv run --locked mypy .
        run_check "$name: pytest" "cd $2 && uv run --locked pytest -v" uv run --locked pytest
        exit $FAILED
    ) || FAILED=1
}

if [ $RUN_BACKEND -eq 1 ]; then
    echo ""
    echo -e "${YELLOW}=== Backend Checks ===${NC}"
    run_python_checks "Backend" backend
fi

if [ $RUN_MCP -eq 1 ]; then
    echo ""
    echo -e "${YELLOW}=== MCP Server Checks ===${NC}"
    run_python_checks "MCP" mcp-server
fi

if [ $RUN_FRONTEND -eq 1 ]; then
    echo ""
    echo -e "${YELLOW}=== Frontend Checks ===${NC}"
    (
        cd frontend || exit 1
        run_check "Frontend: ESLint" "cd frontend && npm run lint -- --fix" npm run lint
        run_check "Frontend: TypeScript" "cd frontend && npm run typecheck" npm run typecheck
        exit $FAILED
    ) || FAILED=1
fi

if [ $RUN_BACKEND -eq 0 ] && [ $RUN_MCP -eq 0 ] && [ $RUN_FRONTEND -eq 0 ]; then
    echo "No backend, mcp-server, or frontend changes staged; skipping component checks."
fi

echo ""
echo -e "${YELLOW}=== Summary ===${NC}"

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
    exit 0
else
    echo -e "${RED}✗ Some pre-commit checks failed. Please fix the issues above.${NC}"
    exit 1
fi
