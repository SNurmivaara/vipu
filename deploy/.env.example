# Required settings
POSTGRES_PASSWORD=your-secure-database-password
SECRET_KEY=your-secret-key-for-flask-sessions

# MCP requires this token OR complete OAuth configuration (mcp-server/OAUTH.md).
MCP_AUTH_TOKEN=your-mcp-token-here
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_RESOURCE_URL=https://vipu-mcp.example.com/mcp
# MCP_OAUTH_JWKS_URL=https://auth.example.com/jwks.json
# MCP_OAUTH_ALLOWED_CLIENTS=vipu-chatgpt,vipu-claude
# MCP_OAUTH_ALLOWED_USERS=your-authelia-username

# CORS origins (comma-separated if multiple)
# Not needed if frontend and backend are on the same domain via reverse proxy
CORS_ORIGINS=http://localhost:3000

# Optional: Pin to a specific version (default: latest)
# VERSION=v1.0.1

# Optional: Change default ports
# BACKEND_PORT=5000
# FRONTEND_PORT=3000
