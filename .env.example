# Docker Compose environment variables
# Copy this to .env and fill in every secret.
# Generate each one with: openssl rand -hex 32

# Flask secret key
SECRET_KEY=

# PostgreSQL password
POSTGRES_PASSWORD=

CORS_ORIGINS=http://your-domain:3000

# Bearer token for the MCP endpoint.
# Required unless OAuth is fully configured. Optional during OAuth migration.
MCP_AUTH_TOKEN=

# OAuth for ChatGPT and Claude web: see mcp-server/OAUTH.md.
# Set all five to enable; remove MCP_AUTH_TOKEN after migrating existing clients.
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_RESOURCE_URL=https://vipu-mcp.example.com/mcp
# MCP_OAUTH_JWKS_URL=https://auth.example.com/jwks.json
# MCP_OAUTH_ALLOWED_CLIENTS=vipu-chatgpt,vipu-claude
# MCP_OAUTH_ALLOWED_USERS=your-authelia-username

# Address the frontend and MCP ports bind to (default: 127.0.0.1). The web app
# has no login of its own; expose it only behind an authenticating reverse proxy.
# BIND_ADDRESS=0.0.0.0
