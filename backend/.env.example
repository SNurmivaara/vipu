# Database connection (required in production)
DATABASE_URL=postgresql://vipu:vipu@localhost:5432/vipu

# Flask environment (development, production, testing)
FLASK_ENV=development

# Secret key for Flask sessions. Required in production; development falls back
# to a fixed key when unset. Generate with: openssl rand -hex 32
# SECRET_KEY=

# CORS allowed origins (comma-separated, e.g., "http://localhost:3000,https://app.example.com")
CORS_ORIGINS=http://localhost:3000

# Optional DNS rebinding protection (off when unset): hostnames the backend may
# be reached by, comma-separated, ports ignored. Include every name clients use,
# such as the frontend proxy's and MCP server's backend address (e.g. "backend")
# and the public hostname. /api/health is always allowed.
# VIPU_ALLOWED_HOSTS=localhost,backend,vipu.example.com
