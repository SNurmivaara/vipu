FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d

WORKDIR /app

# Install uv for fast package management
COPY --from=ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 /uv /usr/local/bin/uv

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies. The dev extra is skipped: its vipu-backend path
# dependency is for the test suite and is not in this build context.
RUN uv sync --frozen --no-dev --no-install-project

# Copy application code
COPY vipu_mcp/ ./vipu_mcp/

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PORT=5100

# Expose port
EXPOSE 5100

# Run with hot reloading
CMD uvicorn vipu_mcp.server:create_app --factory --host 0.0.0.0 --port ${PORT:-5100} --reload --reload-dir vipu_mcp
