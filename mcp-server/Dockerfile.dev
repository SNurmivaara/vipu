FROM python:3.12-slim

WORKDIR /app

# Install uv for fast package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies. The dev extra is skipped: its vipu-backend path
# dependency is for the test suite and is not in this build context.
RUN uv sync --frozen --no-dev --no-install-project

# Copy application code
COPY vipu_mcp/ ./vipu_mcp/

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PORT=5100

# Expose port
EXPOSE 5100

# Run with hot reloading
CMD uvicorn vipu_mcp.server:create_app --factory --host 0.0.0.0 --port ${PORT:-5100} --reload --reload-dir vipu_mcp
