    "/api/networth/forecast": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["month", "quarter", "half_year", "year"] },
            "description": "Time period to base projection on. Default: quarter."
          },
          {
            "in": "query",
            "name": "months_ahead",
            "schema": { "type": "integer", "minimum": 1, "maximum": 36 },
            "description": "Number of months to project. Default: 12."
          }
        ],
        "responses": {
          "200": {
            "content": { "application/json": { "schema": {} } },
            "description": "Successful response"
          }
        },
        "tags": ["Net Worth"],
        "summary": "Get net worth forecast based on historical trend.",
        "description": "Returns projected net worth values and the monthly change rate used for projection."
      }
