# Environment files at any depth; the .env.example templates stay tracked
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Database
*.db
*.sqlite*
postgres-data/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets & Private Data
*.pem
*.key
secrets/
.private/

# Claude: share settings.json, skills and agents; keep personal state local
.claude/settings.local.json
.claude/worktrees/

# Machine-specific Codex configuration
.codex/

# Next.js (for later)
.next/
out/
node_modules/

# Coverage
htmlcov/
.coverage
coverage.xml
